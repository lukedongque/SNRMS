<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SNRMS.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SNRMS"
    xmlns:helpers="using:SNRMS.Helpers"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:BooleanToVisibilityConverter x:Key="BoolToVisible" />
            <helpers:InverseBoolToVisibilityConverter x:Key="BoolToInvisible" />
            <helpers:DateTimeToTimeStringConverter x:Key="TimeFormatter" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisible" />

        </ResourceDictionary>
    </Application.Resources>
</Application>