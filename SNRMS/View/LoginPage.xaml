<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SNRMS.View.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:SNRMS.ViewModels">

    <Page.DataContext>
        <viewmodels:LoginViewModel />
    </Page.DataContext>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Gemini_Generated_Image_t90d6xt90d6xt90d.png" />

        </Grid.Background>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="380" Padding="40"
                Background="White" CornerRadius="16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Spacing="20">

                <!-- Title -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="NurseSync" FontSize="32" FontWeight="Bold"
                               Foreground="#2B6CB0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Student Nurse Rotation Management System" 
                               FontSize="11" Foreground="#718096" 
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" Background="#E2E8F0" Margin="0,4,0,4"/>

                <!-- Fields -->
                <TextBox Header="Username"
                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter your username"/>

                <PasswordBox Header="Password"
                             Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Enter your password"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#E53E3E"
                           FontSize="12"
                           TextWrapping="Wrap"/>

                <!-- Login Button -->
                <Button Content="Login" 
                        HorizontalAlignment="Stretch"
                        Command="{Binding LoginCommand}"
                        Background="#2B6CB0"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="0,12,0,12"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>