<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SNRMS.View.InstructorDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:SNRMS.ViewModels">

    <Page.DataContext>
        <viewmodels:InstructorDashboardViewModel />
    </Page.DataContext>

    <Grid Background="#F0F4F8">
        <NavigationView x:Name="NavView"
                        SelectionChanged="NavView_SelectionChanged"
                        PaneTitle="Instructor Dashboard"
                        IsBackButtonVisible="Collapsed"
                        Background="#F0F4F8">
            <NavigationView.PaneFooter>
                <Grid Padding="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" 
                  Glyph="&#xE77B;" 
                  FontSize="16" 
                  Foreground="#1B3A6B" 
                  VerticalAlignment="Center" 
                  Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstructorDisplayName, Mode=OneWay}" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="#1B3A6B" 
                                   TextTrimming="CharacterEllipsis" 
                                   TextWrapping="NoWrap"/>

                        <TextBlock Text="{Binding InstructorEmployeeId, Mode=OneWay}" 
                                   FontSize="11" 
                                   Foreground="#718096"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                        
                        <TextBlock Text="{Binding InstructorSection, Mode=OneWay}" 
                                    FontSize="11" 
                                    Foreground="#718096"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"/>


                    </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>
            
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Logout" 
                    Icon="LeaveChat" 
                    Foreground="#E53E3E" 
                    SelectsOnInvoked="False"
                    Tapped="Logout_Tapped" />
                
            </NavigationView.FooterMenuItems>
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Groups" Tag="Groups" Icon="People"/>
                <NavigationViewItem Content="Students" Tag="Students" Icon="Contact"/>
                <NavigationViewItem Content="Rotations" Tag="Rotations" Icon="Calendar"/>
                <NavigationViewItem Content="Attendance" Tag="Attendance" Icon="Clock"/>
            </NavigationView.MenuItems>

            <Grid Padding="32">

                <!-- GROUPS PANEL -->
                <StackPanel x:Name="GroupsPanel" Visibility="Collapsed" Spacing="20">
                    <StackPanel>
                        <TextBlock Text="Group Management" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                        <TextBlock Text="Organize and monitor your student groups for thecurrent semester " FontSize="16" Foreground="#909191"/>
                    </StackPanel>
                  
                    <!-- Create Group Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create New Group" FontWeight="SemiBold" 
                                       Foreground="#2D3748" FontSize="16"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBox Header="Group Name" 
                                         Text="{Binding GroupName, Mode=TwoWay}"
                                         Width="200" PlaceholderText="e.g. Group 1"/>
                                <Button Content="Create Group" VerticalAlignment="Bottom"
                                        Command="{Binding CreateGroupCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Groups List Card -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">

                            <StackPanel Spacing="12">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="All Groups" FontWeight="SemiBold" 
                                                Foreground="#2D3748" FontSize="16"/>
                                    <TextBlock Text="Sort by:" VerticalAlignment="Center" 
                                                Foreground="#718096" FontSize="12" Margin="16,0,0,0"/>
                                    <Button Content="Group Name" 
                                            Command="{Binding SortGroupsByNameCommand}"
                                            Background="#E2E8F0" Foreground="#2D3748"
                                            CornerRadius="6" Padding="8,4"/>
                                </StackPanel>
                                <Grid Padding="20,4" Margin="0,16,0,0" Background="#F7FAFC">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Group Name" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Member Count" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>



                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="#E2E8F0"/>
                                <ListView ItemsSource="{Binding Groups}"
                                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                          Height="250">     

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding GroupName}" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#2D3748"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Students.Count, Mode=OneWay}" 
                                                           FontSize="12" 
                                                           Foreground="#718096"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button Content="Delete Group" 
                                        Click="DeleteGroup_Clicked"
                                        Background="#E53E3E" Foreground="White" CornerRadius="8"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Group Members List Card -->
                        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="12">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Group Members" FontWeight="SemiBold" 
                                                Foreground="#2D3748" FontSize="16"/>
                                    
                                </StackPanel>
                                <Grid Padding="20,4" Margin="0,16,0,0" Background="#F7FAFC">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Student's Name" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Student ID" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>



                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Background="#E2E8F0"/>
                                <ListView ItemsSource="{Binding GroupMembers}"
                                          SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                          Height="250">

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" >
                                                    <TextBlock Text="{Binding FirstName}" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="#2D3748"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding LastName}" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="#2D3748"
                                                               VerticalAlignment="Center"/>     

                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="1" 
                                                       Text="{Binding StudentNumber}" 
                                                       FontSize="12" 
                                                       Foreground="#718096"
                                                       VerticalAlignment="Center"/> 
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="Transfer Group: " FontWeight="SemiBold" 
                                               VerticalAlignment="Center" Foreground="#718096" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding Groups}"
                                              SelectedItem="{Binding GroupToTransfer, Mode=TwoWay}"
                                              Width="150">     
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding GroupName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="Transfer" VerticalAlignment="Bottom"
                                            Command="{Binding TransferStudentCommand}"
                                            Background="#1B3A6B" Foreground="White" CornerRadius="8"/>
                                </StackPanel>
                                
                            </StackPanel>

                        </Border>
                    </Grid>
                    
                    
                </StackPanel>

                <!-- STUDENTS PANEL -->
                <StackPanel x:Name="StudentsPanel" Visibility="Collapsed" Spacing="20">
                    <TextBlock Text="Students" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>

                    <!-- Create Student Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Add New Student" FontWeight="SemiBold" 
                                       Foreground="#2D3748" FontSize="16"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBox Header="First Name" 
                                         Text="{Binding StudentFirstName, Mode=TwoWay}"
                                         Width="150" PlaceholderText="First Name"/>
                                <TextBox Header="Last Name" 
                                         Text="{Binding StudentLastName, Mode=TwoWay}"
                                         Width="150" PlaceholderText="Last Name"/>
                                <TextBox Header="Email" 
                                         Text="{Binding StudentEmail, Mode=TwoWay}"
                                         Width="200" PlaceholderText="email@school.com"/>
                                <TextBox Header="Student Number" 
                                         Text="{Binding StudentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="150" PlaceholderText="e.g. 2021-0001"/>
                                <Button Content="Add Student" VerticalAlignment="Bottom"
                                        Command="{Binding CreateStudentCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Students List Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Students" FontWeight="SemiBold" 
                                           VerticalAlignment="Center" Foreground="#2D3748" FontSize="16"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Search: " FontWeight="SemiBold" 
                                                VerticalAlignment="Center" Foreground="#718096" FontSize="12" Margin="80,0,0,0"/>
                                    <TextBox Text="{Binding StudentSearchQuery, Mode=TwoWay}"
                                                Width="150"/>
                                    <Button Content="Search" VerticalAlignment="Bottom"
                                                Command="{Binding SearchStudentCommand}"
                                                Background="#E2E8F0" Foreground="#2D3748" CornerRadius="6"/>
                                    <TextBlock Text="Filter: " FontWeight="SemiBold" 
                                               VerticalAlignment="Center" Foreground="#718096" FontSize="12" Margin="80,0,0,0"/>
                                    
                                    <ComboBox ItemsSource="{Binding Groups}"
                                              SelectedItem="{Binding StudentGroupFilter, Mode=TwoWay}"
                                              PlaceholderText="All Groups"
                                              Width="150" Margin="2,0,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding GroupName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="Filter" VerticalAlignment="Bottom"
                                            Command="{Binding FilterStudentsByGroupCommand}"
                                            Background="#E2E8F0" Foreground="#2D3748" CornerRadius="6"/>   
                                    <Button Content="Show All" VerticalAlignment="Bottom"
                                            Command="{Binding LoadDataCommand}"
                                            Background="#E2E8F0" Foreground="#2D3748" CornerRadius="6"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid Padding="20,4" Margin="0,16,0,0" Background="#F7FAFC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Last Name" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="First Name" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Student ID" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Email" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Group" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                
                               
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="#E2E8F0"/>
                            
                            <ListView ItemsSource="{Binding Students}"
                                      SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                      Height="250">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding LastName}" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#2D3748"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding FirstName}" 
                                                       Foreground="#2D3748"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding StudentNumber}" 
                                                       FontSize="12"
                                                       Foreground="#718096"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding Email}" 
                                                       FontSize="12"
                                                       Foreground="#718096"
                                                       VerticalAlignment="Center"/> 
                                            <TextBlock Grid.Column="4" 
                                                       Text="{Binding Group.GroupName}" 
                                                       FontSize="12"
                                                       Foreground="#1B3A6B"
                                                       VerticalAlignment="Center"/>
                                            
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button VerticalAlignment="Bottom" Content="Delete Student" 
                                        Click="DeleteStudent_Clicked"
                                        Background="#E53E3E" Foreground="White" CornerRadius="8"/>
                                <ComboBox Header="Assign to Group"
                                          ItemsSource="{Binding Groups}"
                                          SelectedItem="{Binding GroupToTransfer, Mode=TwoWay}"
                                          Width="150"> 
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GroupName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Transfer" VerticalAlignment="Bottom"
                                        Command="{Binding TransferStudentCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="8"/>
                                <Button Content="Edit Student"
                                        VerticalAlignment="Bottom"
                                        Click="EditStudent_Clicked"
                                        Background="#1B3A6B" Foreground="White"
                                        CornerRadius="8" />   
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ROTATIONS PANEL -->
                <StackPanel x:Name="RotationsPanel" Visibility="Collapsed" Spacing="20">
                    <TextBlock Text="Rotation Assignments" FontSize="28" FontWeight="Bold" 
                               Foreground="#1B3A6B"/>

                    <!-- Create Rotation Card -->
                    <Border Background="White" CornerRadius="12" Padding="24"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Create Rotation Assignment" FontWeight="SemiBold" 
                                       Foreground="#2D3748" FontSize="16"/>
                            <!-- Row 1: Group, Hospital, Station, DaySlot -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" Header="Group"
                                          ItemsSource="{Binding Groups}"
                                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GroupName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ComboBox Grid.Column="1" Header="Hospital"
                                          ItemsSource="{Binding Hospitals}"
                                          SelectedItem="{Binding SelectedRotationHospital, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HospitalName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ComboBox Grid.Column="2" Header="Station"
                                          ItemsSource="{Binding FilteredStations}"
                                          SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StationName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="3" Header="Station Capacity"
                                         IsReadOnly="True"
                                         Text="{Binding SelectedStation.Capacity}"/>

                                <ComboBox Grid.Column="4" Header="Day Slot"
                                          ItemsSource="{Binding DaySlotsList}"
                                          SelectedItem="{Binding DaySlot, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Row 2: Dates and Times -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Column="0" Header="Start Date"
                                            Date="{Binding RotationStartDate, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch" Margin="0,0,8,0"/>

                                <DatePicker Grid.Column="1" Header="End Date"
                                            Date="{Binding RotationEndDate, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch" Margin="0,0,8,0"/>

                                <TimePicker Grid.Column="2" Header="Start Time"
                                            SelectedTime="{Binding RotationStartTime, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch" Margin="0,0,8,0"/>

                                <TimePicker Grid.Column="3" Header="End Time"
                                            SelectedTime="{Binding RotationEndTime, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Row 3: Create Button -->
                            <Button Content="Create Assignment"
                                    Command="{Binding CreateRotationAssignmentCommand}"
                                    Background="#1B3A6B" Foreground="White"
                                    CornerRadius="8" Padding="16,8"
                                    HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <!-- Rotation List Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="All Rotation Assignments" FontWeight="SemiBold" 
                                       Foreground="#2D3748" FontSize="16"/>

                            <!-- Column Headers -->
                            <Grid Padding="8,4" Background="#F7FAFC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Group" FontWeight="SemiBold" 
                                           Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Hospital" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Station" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Day Slot" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Start Date" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="End Date" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="6" Text="Time" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="#E2E8F0"/>

                            <!-- List -->
                            <ListView ItemsSource="{Binding RotationAssignments}"
                                      SelectedItem="{Binding SelectedRotationAssignment, Mode=TwoWay}"
                                      Height="250"> 
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,8" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Group.GroupName}" 
                                                       FontWeight="SemiBold"
                                                       Foreground="#2D3748"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Station.Hospital.HospitalName}" 
                                                       Foreground="#2D3748"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Station.StationName}" 
                                                       Foreground="#2D3748"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding DaySlot}" 
                                                       FontSize="12"
                                                       Foreground="#718096"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="4" 
                                                       Text="{Binding StartDate}" 
                                                       FontSize="12"
                                                       Foreground="#718096"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="5" 
                                                       Text="{Binding EndDate}" 
                                                       FontSize="12"
                                                       Foreground="#718096"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding StartTime}" 
                                                           FontSize="12"
                                                           Foreground="#718096"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="-" FontSize="12" Foreground="#718096"/>
                                                <TextBlock Text="{Binding EndTime}" 
                                                           FontSize="12"
                                                           Foreground="#718096"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Orientation="Horizontal" >
                                <!-- Delete Button -->
                            <Button Content="Delete Assignment" 
                                    Click="DeleteRotation_Clicked"
                                    Background="#E53E3E" Foreground="White" CornerRadius="8"/>
                            <TextBlock Text="Filter: " FontWeight="SemiBold" 
                                        VerticalAlignment="Center" Foreground="#718096" FontSize="12" Margin="80,0,0,0"/>
    
                                <!--Filter-->
                            <ComboBox ItemsSource="{Binding Groups}"
                                      SelectedItem="{Binding FilterRotationGroup, Mode=TwoWay}"
                                      PlaceholderText="All Groups"
                                      Width="150" Margin="2,0,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GroupName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                                <Button Content="Filter" VerticalAlignment="Bottom"
                                    Command="{Binding GetRotationAssignmentByGroupCommand}"
                                    Background="#E2E8F0" Foreground="#2D3748" CornerRadius="6"/>
                                <Button Content="Show All" VerticalAlignment="Bottom"
                                        Command="{Binding GetAllRotationAssignmentsCommand}"
                                        Background="#E2E8F0" Foreground="#2D3748" CornerRadius="6"/>
                            </StackPanel>
                            
                            
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
                
               
                <!-- ATTENDANCE PANEL -->
                <ScrollViewer x:Name="AttendancePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <StackPanel>
                            <TextBlock Text="Attendance" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                            <TextBlock Text="View and filter student clock-in and clock-out records"
                                       FontSize="14" Foreground="#909191"/>
                        </StackPanel>

                        <!-- Filter Card -->
                        <Border Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Filter Records" FontWeight="SemiBold"
                                           Foreground="#2D3748" FontSize="16"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">

                                    <!-- Filter by Rotation -->
                                    <ComboBox Header="Filter by Rotation"
                                              ItemsSource="{Binding RotationAssignments}"
                                              SelectedItem="{Binding AttendanceFilterRotation, Mode=TwoWay}"
                                              PlaceholderText="All Rotations"
                                              Width="220">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{Binding Group.GroupName}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Station.StationName}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Filter by Date -->
                                    <DatePicker Header="Filter by Date"
                                                Date="{Binding AttendanceFilterDate, Mode=TwoWay}"/>
                                    <!-- Load Filter Button -->
                                    <Button Content="Filter"
                                            Command="{Binding LoadFilteredAttendanceCommand}"
                                            VerticalAlignment="Bottom"
                                            Background="#1B3A6B" Foreground="White" CornerRadius="8"
                                            Padding="16,8"/>

                                    <!-- Load All Button -->
                                    <Button Content="Load Attendance"
                                            Command="{Binding LoadAllAttendanceCommand}"
                                            VerticalAlignment="Bottom"
                                            Background="#1B3A6B" Foreground="White" CornerRadius="8"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Records Card -->
                        <Border Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Attendance Records" FontWeight="SemiBold"
                                           Foreground="#2D3748" FontSize="16"/>

                                <!-- Column Headers -->
                                <Grid Padding="8,4" Background="#F7FAFC">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Student" FontWeight="SemiBold"
                                               Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Student No." FontWeight="SemiBold"
                                               Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="Station" FontWeight="SemiBold"
                                               Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="Date" FontWeight="SemiBold"
                                               Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="Time In" FontWeight="SemiBold"
                                               Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="5" Text="Time Out" FontWeight="SemiBold"
                                               Foreground="#718096" FontSize="12"/>
                                </Grid>

                                <Border Height="1" Background="#E2E8F0"/>

                                <ListView ItemsSource="{Binding AttendanceRecords}"
                                          SelectionMode="None"
                                          Height="350">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" CornerRadius="6" Padding="8,10"
                                                    Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Student Name -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Student.FirstName}"
                                                                   FontWeight="SemiBold" Foreground="#2D3748" FontSize="13"/>
                                                        <TextBlock Text="{Binding Student.LastName}"
                                                                   FontWeight="SemiBold" Foreground="#2D3748" FontSize="13"/>
                                                    </StackPanel>

                                                    <!-- Student Number -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Student.StudentNumber}"
                                                               Foreground="#718096" FontSize="12"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Station -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding RotationAssignment.Station.StationName, FallbackValue='—'}"
                                                               Foreground="#4A5568" FontSize="12"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Date -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding DateToday}"
                                                               Foreground="#4A5568" FontSize="12"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Time In -->
                                                    <Border Grid.Column="4" Background="#F0FFF4"
                                                            CornerRadius="6" Padding="8,4"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TimeIn, Converter={StaticResource TimeFormatter}}"
                                                                   Foreground="#38A169" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Time Out -->
                                                    <Border Grid.Column="5" Background="#FFF5F5"
                                                            CornerRadius="6" Padding="8,4"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TimeOut, Converter={StaticResource TimeFormatter}, FallbackValue='—'}"
                                                                   Foreground="#E53E3E" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Empty state -->
                                <TextBlock Text="No attendance records found. Use the filters above and click Load Attendance."
                                           Foreground="#A0AEC0" FontSize="13" FontStyle="Italic"
                                           Visibility="{Binding HasNoAttendanceRecords, Mode=OneWay,
                                                        Converter={StaticResource BoolToVisible}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS PANEL -->
                <Grid Padding="32">
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">

                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                                <TextBlock Text="Manage your account security and application preferences" 
                                            FontSize="14" Foreground="#909191"/>
                            </StackPanel>

                            <Border Background="White" CornerRadius="12" Padding="24" 
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE72E;" Foreground="#1B3A6B" FontSize="20"/>
                                        <TextBlock Text="Account Security" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="#F0F4F8"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Password" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="It's a good idea to use a strong password that you're not using elsewhere." 
                                                    Foreground="#718096" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Content="Change Password" 
                                            Click="ChangePassword_Click"
                                            Background="#1B3A6B" Foreground="White"
                                            Padding="24,10" CornerRadius="8"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="12" Padding="24" 
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Profile Information" FontSize="18" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="20" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock  Text="Full Name" Foreground="#718096" VerticalAlignment="Center"/>
                                            <TextBlock  Text="{Binding InstructorDisplayName}" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock  Text="Employee ID" Foreground="#718096" VerticalAlignment="Center"/>
                                            <TextBlock  Text="{Binding InstructorEmployeeId}" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock  Text="Email" Foreground="#718096" VerticalAlignment="Center"/>
                                            <TextBlock  Text="{Binding InstructorEmail}" FontWeight="Medium"/>
                                        </StackPanel>

                                       
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>

                <ContentDialog x:Name="ChangePasswordDialog"
                               Title="Change Password"
                               PrimaryButtonText="Save Changes"
                               CloseButtonText="Cancel"
                               DefaultButton="Primary"
                               Style="{StaticResource DefaultContentDialogStyle}">
                    <StackPanel Spacing="16" Width="320">
                        <PasswordBox x:Name="CurrentPasswordBox" 
                                     Header="Current Password" 
                                     PlaceholderText="Verify current password"
                                     PasswordRevealMode="Hidden"/>

                        <Rectangle Height="1" Fill="#E2E8F0" Margin="0,8"/>

                        <PasswordBox x:Name="NewPasswordBox" 
                                     Header="New Password" 
                                     PlaceholderText="Minimum 6 characters"
                                     PasswordRevealMode="Hidden"/>

                        <PasswordBox x:Name="ConfirmPasswordBox" 
                                     Header="Confirm New Password" 
                                     PlaceholderText="Repeat new password"
                                     PasswordRevealMode="Hidden"/>

                        <InfoBar x:Name="DialogInfoBar" 
                                 IsOpen="False" 
                                 Severity="Error" 
                                 FontSize="12"/>
                    </StackPanel>
                </ContentDialog>

                <!-- Messages -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53E3E" 
                           VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#38A169" 
                           VerticalAlignment="Bottom" TextWrapping="Wrap"/>
            </Grid>
        </NavigationView>
    </Grid>
</Page>