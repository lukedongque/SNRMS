<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SNRMS.View.StudentDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:SNRMS.ViewModels">

    <Page.DataContext>
        <viewmodels:StudentDashboardViewModel />
    </Page.DataContext>

    <Grid Background="#F0F4F8">
        <NavigationView x:Name="NavView"
                        SelectionChanged="NavView_SelectionChanged"
                        PaneTitle="Student Dashboard"
                        IsBackButtonVisible="Collapsed"
                        Background="#F0F4F8">

            <!-- Student name + number in nav footer -->
            <NavigationView.PaneFooter>
                <Grid Padding="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE77B;"
                              FontSize="16"
                              Foreground="#1B3A6B"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding StudentDisplayName, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#1B3A6B"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StudentNumber, Mode=OneWay}"
                                   FontSize="11" Foreground="#718096"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="11" Foreground="#718096" TextTrimming="CharacterEllipsis">
                            <Run Text="BSN"/>
                            <Run Text="{Binding StudentYearLevel}"/>
                            <Run Text=" . "/>
                            <Run Text="{Binding StudentSectionName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding StudentGroupName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>


            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Logout"
                                    Icon="LeaveChat"
                                    Foreground="#E53E3E"
                                    SelectsOnInvoked="False"
                                    Tapped="Logout_Tapped"/>
            </NavigationView.FooterMenuItems>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="My Rotation" Tag="Rotation" Icon="Calendar"/>
                <NavigationViewItem Content="Schedule"    Tag="Schedule"  Icon="View"/>
                <NavigationViewItem Content="History"     Tag="History"   Icon="Clock"/>
            </NavigationView.MenuItems>

            <Grid Padding="32">

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- MY ROTATION PANEL                                        -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="RotationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <StackPanel>
                            <TextBlock Text="My Rotation" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                            <TextBlock Text="Your current and upcoming clinical rotation details"
                                       FontSize="14" Foreground="#909191"/>
                        </StackPanel>

                        <!-- Error / no-rotation notice -->
                        <Border Background="#FFF5F5" CornerRadius="10" Padding="16"
                                BorderBrush="#FEB2B2" BorderThickness="1"
                                Visibility="{Binding HasCurrentRotation, Mode=OneWay,
                                             Converter={StaticResource BoolToInvisible}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" Foreground="#E53E3E" FontSize="18"/>
                                <TextBlock Text="You have no active rotation assignment at this time."
                                           Foreground="#C53030" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Current Rotation Card ── -->
                        <Border Background="White" CornerRadius="12" Padding="24"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <!-- Header row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Current Rotation"
                                                   FontSize="18" FontWeight="Bold" Foreground="#1B3A6B"/>
                                        <TextBlock Text="{Binding CurrentDateRange, Mode=OneWay}"
                                                   FontSize="13" Foreground="#718096" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EBF8FF"
                                            CornerRadius="20" Padding="12,6">
                                        <TextBlock Text="{Binding CurrentDaySlot, Mode=OneWay}"
                                                   FontWeight="SemiBold" Foreground="#1B3A6B" FontSize="13"/>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="#E2E8F0"/>

                                <!-- Detail grid -->
                                <Grid ColumnSpacing="24" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Hospital -->
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Background="#F7FAFC" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="HOSPITAL" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A0AEC0" CharacterSpacing="100"/>
                                            <TextBlock Text="{Binding CurrentHospitalName, Mode=OneWay}"
                                                       FontSize="16" FontWeight="Bold" Foreground="#2D3748"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Station -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="#F7FAFC" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="STATION" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A0AEC0" CharacterSpacing="100"/>
                                            <TextBlock Text="{Binding CurrentStationName, Mode=OneWay}"
                                                       FontSize="16" FontWeight="Bold" Foreground="#2D3748"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Time -->
                                    <Border Grid.Row="1" Grid.Column="0"
                                            Background="#F7FAFC" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="TIME" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A0AEC0" CharacterSpacing="100"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding CurrentStartTime, Mode=OneWay}"
                                                           FontSize="15" FontWeight="Bold" Foreground="#2D3748"/>
                                                <TextBlock Text="—" Foreground="#A0AEC0" FontSize="15"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CurrentEndTime, Mode=OneWay}"
                                                           FontSize="15" FontWeight="Bold" Foreground="#2D3748"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group -->
                                    <Border Grid.Row="1" Grid.Column="1"
                                            Background="#F7FAFC" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="GROUP" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A0AEC0" CharacterSpacing="100"/>
                                            <TextBlock Text="{Binding CurrentRotation.Group.GroupName, Mode=OneWay,
                                                               FallbackValue='—'}"
                                                       FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- ── Attendance ── -->
                                <Rectangle Height="1" Fill="#E2E8F0"/>

                                <StackPanel Spacing="12">
                                    <TextBlock Text="ATTENDANCE"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="#A0AEC0" CharacterSpacing="100"/>

                                    <StackPanel Orientation="Horizontal" Spacing="12">

                                        <!-- Clock In -->
                                        <Button Command="{Binding MarkAttendanceCommand}"
                                                IsEnabled="{Binding CanMarkAttendance, Mode=OneWay}"
                                                Background="#1B3A6B"
                                                Foreground="White"
                                                CornerRadius="8"
                                                Padding="20,10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7B3;" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="Clock In" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Clock Out -->
                                        <Button Command="{Binding ClockOutCommand}"
                                                IsEnabled="{Binding CanClockOut, Mode=OneWay}"
                                                Background="#E53E3E"
                                                Foreground="White"
                                                CornerRadius="8"
                                                Padding="20,10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7B3;" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="Clock Out" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>

                                    <!-- Clock In status -->
                                    <TextBlock Text="{Binding AttendanceStatusMessage, Mode=OneWay}"
                                               FontSize="13" Foreground="#38A169" FontStyle="Italic"
                                               Visibility="{Binding AlreadyMarkedAttendance, Mode=OneWay,
                                                            Converter={StaticResource BoolToVisible}}"/>

                                    <!-- Clock Out status -->
                                    <TextBlock Text="{Binding ClockOutStatusMessage, Mode=OneWay}"
                                               FontSize="13" Foreground="#E53E3E" FontStyle="Italic"
                                               Visibility="{Binding AlreadyClockedOut, Mode=OneWay,
                                                            Converter={StaticResource BoolToVisible}}"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>


                        <!-- ── Next Rotation Card ── -->
                        <Border Background="White" CornerRadius="12" Padding="24"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Next Rotation"
                                                   FontSize="18" FontWeight="Bold" Foreground="#1B3A6B"/>
                                        <TextBlock Text="{Binding NextDateRange, Mode=OneWay}"
                                                   FontSize="13" Foreground="#718096" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F0FFF4"
                                            CornerRadius="20" Padding="12,6">
                                        <TextBlock Text="{Binding NextDaySlot, Mode=OneWay}"
                                                   FontWeight="SemiBold" Foreground="#38A169" FontSize="13"/>
                                    </Border>
                                </Grid>
                                <Rectangle Height="1" Fill="#E2E8F0"/>

                                <!-- No next rotation message -->
                                <TextBlock Foreground="#A0AEC0" FontSize="13" FontStyle="Italic"
                                           Visibility="{Binding HasNextRotation, Mode=OneWay,
                                                        Converter={StaticResource BoolToInvisible}}"
                                           Text="No upcoming rotation scheduled yet."/>

                                <Grid ColumnSpacing="24" Visibility="{Binding HasNextRotation, Mode=OneWay,
                                      Converter={StaticResource BoolToVisible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F7FAFC" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="HOSPITAL" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A0AEC0" CharacterSpacing="100"/>
                                            <TextBlock Text="{Binding NextHospitalName, Mode=OneWay}"
                                                       FontSize="15" FontWeight="Bold" Foreground="#2D3748"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F7FAFC" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="STATION" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A0AEC0" CharacterSpacing="100"/>
                                            <TextBlock Text="{Binding NextStationName, Mode=OneWay}"
                                                       FontSize="15" FontWeight="Bold" Foreground="#2D3748"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- SCHEDULE PANEL                                           -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="SchedulePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <StackPanel>
                            <TextBlock Text="My Schedule" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                            <TextBlock Text="All rotation assignments for your group"
                                       FontSize="14" Foreground="#909191"/>
                        </StackPanel>

                        <Border Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Rotation Schedule" FontWeight="SemiBold"
                                           Foreground="#2D3748" FontSize="16"/>

                                <!-- No schedule message -->
                                <TextBlock Text="No schedule available yet."
                                           Foreground="#A0AEC0" FontSize="13" FontStyle="Italic"
                                           Visibility="{Binding HasSchedule, Mode=OneWay,
                                                        Converter={StaticResource BoolToInvisible}}"/>

                                <ListView ItemsSource="{Binding ScheduleAssignments}"
                                          Visibility="{Binding HasSchedule, Mode=OneWay,
                                                       Converter={StaticResource BoolToVisible}}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" CornerRadius="8" Padding="16,12"
                                                    Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Day Slot badge -->
                                                    <Border Grid.Column="0" Background="#EBF8FF"
                                                            CornerRadius="6" Padding="8,4"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding DaySlot}"
                                                                   FontWeight="SemiBold" Foreground="#1B3A6B"
                                                                   FontSize="12"/>
                                                    </Border>

                                                    <!-- Hospital / Station -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Station.Hospital.HospitalName,
                                                                           FallbackValue='—'}"
                                                                   FontWeight="SemiBold" Foreground="#2D3748"
                                                                   FontSize="13"/>
                                                        <TextBlock Text="{Binding Station.StationName,
                                                                           FallbackValue='—'}"
                                                                   Foreground="#718096" FontSize="12"/>
                                                    </StackPanel>

                                                    <!-- Group -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Group.GroupName, FallbackValue='—'}"
                                                               Foreground="#4A5568" FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StartTime, FallbackValue='-'}"
                                                                   Foreground="#4A5568" FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text=" - " 
                                                                   Foreground="#4A5568" Margin="2,0,2,0" FontSize="13"
                                                                    VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding EndTime, FallbackValue='-'}"
                                                                   Foreground="#4A5568" FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    

                                                    <!-- Date range -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock FontSize="12" Foreground="#4A5568">
                                                            <Run Text="{Binding StartDate}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="#4A5568">
                                                            <Run Text="{Binding EndDate}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>


                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- HISTORY PANEL                                            -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="HistoryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <StackPanel>
                            <TextBlock Text="Rotation History" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                            <TextBlock Text="A complete log of all your past clinical rotations"
                                       FontSize="14" Foreground="#909191"/>
                        </StackPanel>

                        <Border Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Past Rotations" FontWeight="SemiBold"
                                           Foreground="#2D3748" FontSize="16"/>

                                <TextBlock Text="No rotation history found."
                                           Foreground="#A0AEC0" FontSize="13" FontStyle="Italic"
                                           Visibility="{Binding HasSchedule, Mode=OneWay,
                                                        Converter={StaticResource BoolToInvisible}}"/>

                                <ListView ItemsSource="{Binding RotationHistory}"
                                          SelectionMode="None"
                                          Visibility="{Binding HasSchedule, Mode=OneWay,
                                                       Converter={StaticResource BoolToVisible}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" CornerRadius="8" Padding="16,12"
                                                    Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#FAF5FF"
                                                            CornerRadius="6" Padding="8,4"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding DaySlot}"
                                                                   FontWeight="SemiBold" Foreground="#718096"
                                                                   FontSize="12"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Station.Hospital.HospitalName,
                                                                           FallbackValue='—'}"
                                                                   FontWeight="SemiBold" Foreground="#2D3748" FontSize="13"/>
                                                        <TextBlock Text="{Binding Station.StationName, FallbackValue='—'}"
                                                                   Foreground="#718096" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Group.GroupName, FallbackValue='—'}"
                                                               Foreground="#4A5568" FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock FontSize="12" Foreground="#4A5568">
                                                            <Run Text="{Binding StartDate}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="#4A5568">
                                                            <Run Text="{Binding EndDate}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS PANEL -->
                <Grid Padding="32">
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">

                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                                <TextBlock Text="Manage your account security and application preferences" 
                            FontSize="14" Foreground="#909191"/>
                            </StackPanel>

                            <Border Background="White" CornerRadius="12" Padding="24" 
                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE72E;" Foreground="#1B3A6B" FontSize="20"/>
                                        <TextBlock Text="Account Security" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="#F0F4F8"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Password" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="It's a good idea to use a strong password that you're not using elsewhere." 
                                    Foreground="#718096" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Content="Change Password" 
                                            Click="ChangePassword_Click"
                                            Background="#1B3A6B" Foreground="White"
                                            Padding="24,10" CornerRadius="8"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
                <!-- Messages -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53E3E" 
                           VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#38A169" 
                           VerticalAlignment="Bottom" TextWrapping="Wrap"/>

            </Grid>
        </NavigationView>
    </Grid>
</Page>
