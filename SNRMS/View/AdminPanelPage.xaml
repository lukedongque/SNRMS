<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SNRMS.View.AdminPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:SNRMS.ViewModels">

    <Page.DataContext>
        <viewmodels:AdminPanelViewModel />
    </Page.DataContext>

    <Grid Background="#F0F4F8">
        <NavigationView x:Name="NavView"
                        SelectionChanged="NavView_SelectionChanged"
                        PaneTitle="Admin Panel"
                        IsBackButtonVisible="Collapsed"
                        Background="#F0F4F8">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Logout"
                        Icon="LeaveChat"
                        Foreground="#E53E3E"
                        SelectsOnInvoked="False"
                        Tapped="Logout_Tapped"/>
            </NavigationView.FooterMenuItems>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Analytics"   Tag="Analytics"   Icon="Repair"/>
                <NavigationViewItem Content="Sections"    Tag="Sections"    Icon="ViewAll"/>
                <NavigationViewItem Content="Instructors" Tag="Instructors" Icon="People"/>
                <NavigationViewItem Content="Hospitals"   Tag="Hospitals"   Icon="Home" />
            </NavigationView.MenuItems>

            <Grid Padding="32">
                <!-- SETTINGS PANEL -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">

                        <!-- Title -->
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                            <TextBlock Text="Manage your account and reset user passwords"
                       FontSize="14" Foreground="#909191"/>
                        </StackPanel>

                        <!-- Card 1: Change Own Password -->
                        <Border Background="White" CornerRadius="12" Padding="24"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel>
                                    <TextBlock Text="Change Password" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Text="You must enter your current password to set a new one."
                               FontSize="12" Foreground="#A0AEC0"/>
                                </StackPanel>
                                <StackPanel Spacing="10">
                                    <PasswordBox x:Name="AdminCurrentPwd"  Header="Current Password"     Width="320" HorizontalAlignment="Left"/>
                                    <PasswordBox x:Name="AdminNewPwd"      Header="New Password"          Width="320" HorizontalAlignment="Left"/>
                                    <PasswordBox x:Name="AdminConfirmPwd"  Header="Confirm New Password"  Width="320" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button Content="Change Password"
                                        Click="AdminChangePassword_Clicked"
                                        Background="#1B3A6B" Foreground="White"
                                        CornerRadius="8" Padding="20,8"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Reset Instructor Password -->
                        <Border Background="White" CornerRadius="12" Padding="24"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel>
                                    <TextBlock Text="Reset Instructor Password" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Text="Resets the instructor's password back to the default: user123"
                                                FontSize="12" Foreground="#A0AEC0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBox x:Name="ResetInstructorBox"
                                             Header="Employee ID"
                                             Text="{Binding ResetEmployeeId, Mode=TwoWay}"
                                             Width="280" PlaceholderText="e.g. EMP001"/>
                                    <Button Content="Reset Password"
                                            VerticalAlignment="Bottom"
                                            Click="ResetInstructorPassword_Clicked"
                                            Background="#ED8936" Foreground="White"
                                            CornerRadius="8" Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Reset Student Password -->
                        <Border Background="White" CornerRadius="12" Padding="24"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel>
                                    <TextBlock Text="Reset Student Password" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Text="Resets the student's password back to their student number."
                               FontSize="12" Foreground="#A0AEC0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBox x:Name="ResetStudentBox"
                                             Header="Student Number"
                                             Text="{Binding ResetStudentNumber, Mode=TwoWay}"
                                             Width="280" PlaceholderText="e.g. 2021-00123"/>
                                    <Button Content="Reset Password"
                                            VerticalAlignment="Bottom"
                                            Click="ResetStudentPassword_Clicked"
                                            Background="#ED8936" Foreground="White"
                                            CornerRadius="8" Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <!-- ANALYTICS PANEL -->
                <ScrollViewer x:Name="AnalyticsPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">

                        <!-- Title -->
                        <StackPanel>
                            <TextBlock Text="Analytics" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>
                            <TextBlock Text="System-wide overview of students, rotations, and hospitals"
                                       FontSize="14" Foreground="#909191"/>
                        </StackPanel>

                        <!-- ── Summary Cards Row 1 ── -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total Students -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE716;" FontSize="18" Foreground="#1B3A6B"/>
                                        <TextBlock Text="Total Students" FontSize="12"
                                                    Foreground="#718096" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalStudents, Mode=OneWay}"
                                                 FontSize="34" FontWeight="Bold" Foreground="#1B3A6B"/>
                                    <TextBlock Text="Active, non-archived" FontSize="11" Foreground="#A0AEC0"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Instructors -->
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="#718096"/>
                                        <TextBlock Text="Instructors" FontSize="12"
                                                    Foreground="#718096" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalInstructors, Mode=OneWay}"
                                                FontSize="34" FontWeight="Bold" Foreground="#1B3A6B"/>
                                    <TextBlock Text="Active Instructor Accounts" FontSize="11" Foreground="#A0AEC0"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Groups -->
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                                     BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE902;" FontSize="18" Foreground="#38A169"/>
                                        <TextBlock Text="Groups" FontSize="12"
                                                     Foreground="#718096" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalGroups, Mode=OneWay}"
                                                FontSize="34" FontWeight="Bold" Foreground="#1B3A6B"/>
                                    <TextBlock Text="Active groups" FontSize="11" Foreground="#A0AEC0"/>
                                </StackPanel>
                            </Border>

                            <!-- Unassigned Sections -->
                            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#E53E3E"/>
                                        <TextBlock Text="Unassigned Sections" FontSize="12"
                                                     Foreground="#718096" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UnassignedSections, Mode=OneWay}"
                                                    FontSize="34" FontWeight="Bold" Foreground="#1B3A6B"/>
                                    <TextBlock Text="No instructor assigned" FontSize="11" Foreground="#A0AEC0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ── Charts Row ── -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Students per Section bar chart -->
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Students per Section" FontWeight="SemiBold"
                                               Foreground="#2D3748" FontSize="16"/>
                                    <ItemsControl ItemsSource="{Binding StudentsPerSection}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4" RowSpacing="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                 FontSize="12" Foreground="#4A5568"
                                                                 VerticalAlignment="Center"/>   
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                 FontSize="12" FontWeight="Bold"
                                                                 Foreground="#1B3A6B"/>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" Value="{Binding Value}"
                                                                   Maximum="50" Height="8"
                                                                   Foreground="#1B3A6B"
                                                                   Background="#EBF8FF"
                                                                   CornerRadius="4"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Rotations per Hospital — Expander dropdown -->
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <StackPanel>
                                        <TextBlock Text="Rotations per Hospital" FontWeight="SemiBold"
                                                   Foreground="#2D3748" FontSize="16"/>
                                        <TextBlock Text="Click a hospital to see its group breakdown"
                                                   FontSize="11" Foreground="#A0AEC0"/>
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding HospitalBreakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Margin="0,4" HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch">
                                                        <Expander.Header>
                                                            <Grid Padding="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding HospitalName}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#1B3A6B"
                                                                               FontSize="13"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Address}"
                                                                               FontSize="11"
                                                                               Foreground="#A0AEC0"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="#EBF8FF"
                                                                        CornerRadius="12" Padding="10,3"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TotalRotations}"
                                                                               FontWeight="Bold"
                                                                               Foreground="#2B9ED4"
                                                                               FontSize="13"/>
                                                                </Border>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <!-- Expanded content: group rows -->
                                                        <ItemsControl ItemsSource="{Binding Groups}"
                                                                      Margin="8,6,0,4">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,4" RowSpacing="3">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid Grid.Row="0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding Label}"
                                                                                       FontSize="12"
                                                                                       Foreground="#4A5568"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Count}"
                                                                                       FontSize="12"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#2B9ED4"/>
                                                                        </Grid>
                                                                        <ProgressBar Grid.Row="1"
                                                                                     Value="{Binding Count}"
                                                                                     Maximum="{Binding MaxValue}"
                                                                                     Height="6"
                                                                                     Foreground="#718096"
                                                                                     Background="#EBF8FF"
                                                                                     CornerRadius="3"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ── Instructor Analytics ── -->
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Instructor Analytics" FontWeight="Bold"
                                               Foreground="#1B3A6B" FontSize="20"/>
                                    <TextBlock Text="Section workload, rotations, and attendance health by clinical instructor"
                                               FontSize="12" Foreground="#718096"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding ActiveInstructors}"
                                              SelectedItem="{Binding SelectedAnalyticsInstructor, Mode=TwoWay}"
                                              Width="260" PlaceholderText="Choose instructor">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding FirstName}"/>
                                                    <TextBlock Text="{Binding LastName}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Command="{Binding LoadInstructorAnalyticsCommand}"
                                            Background="#1B3A6B" Foreground="White"
                                            CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
                                            <TextBlock Text="Load"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F7FAFC" CornerRadius="8" Padding="18"
                                    BorderBrush="#D8E2EE" BorderThickness="1"
                                    Visibility="{Binding HasInstructorAnalytics, Mode=OneWay,
                                                 Converter={StaticResource BoolToVisible}}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstructorAnalyticsName, Mode=OneWay}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   Foreground="#1B3A6B"/>
                                        <TextBlock Text="{Binding InstructorAnalyticsSection, Mode=OneWay}"
                                                   FontSize="13" Foreground="#4A5568"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14"
                                            BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Students" FontSize="11" Foreground="#718096"/>
                                            <TextBlock Text="{Binding InstructorAnalyticsStudents, Mode=OneWay}"
                                                       FontSize="24" FontWeight="Bold" Foreground="#1B3A6B"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14"
                                            BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Groups" FontSize="11" Foreground="#718096"/>
                                            <TextBlock Text="{Binding InstructorAnalyticsGroups, Mode=OneWay}"
                                                       FontSize="24" FontWeight="Bold" Foreground="#2B9ED4"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="14"
                                            BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Rotations" FontSize="11" Foreground="#718096"/>
                                            <TextBlock Text="{Binding InstructorAnalyticsRotations, Mode=OneWay}"
                                                       FontSize="24" FontWeight="Bold" Foreground="#38A169"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="14"
                                            BorderBrush="#E2E8F0" BorderThickness="1">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Student Attendance" FontSize="11" Foreground="#718096"/>
                                            <TextBlock Text="{Binding InstructorAnalyticsAttendanceRate, Mode=OneWay}"
                                                       FontSize="24" FontWeight="Bold" Foreground="#ED8936"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="#FFF5F5" CornerRadius="8" Padding="12,8"
                                    BorderBrush="#FEB2B2" BorderThickness="1"
                                    Visibility="{Binding HasInstructorAnalytics, Mode=OneWay,
                                                 Converter={StaticResource BoolToInvisible}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" Foreground="#E53E3E" FontSize="14"/>
                                    <TextBlock Text="Choose an instructor with an assigned section to show analytics."
                                               Foreground="#C53030" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="16" RowSpacing="16"
                                  Visibility="{Binding HasInstructorAnalytics, Mode=OneWay,
                                               Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="18"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Rotations per Station"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#2D3748"/>
                                        <TextBlock Text="Assigned rotations grouped by clinical station"
                                                   FontSize="12" Foreground="#718096"/>
                                        <lvc:CartesianChart
                                            Series="{Binding RotationsPerStationSeries, Mode=OneWay}"
                                            XAxes="{Binding RotationsPerStationXAxes, Mode=OneWay}"
                                            YAxes="{Binding RotationsPerStationYAxes, Mode=OneWay}"
                                            Height="280"
                                            LegendPosition="Hidden"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="18"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Students per Group"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#2D3748"/>
                                        <TextBlock Text="Current active student count by group"
                                                   FontSize="12" Foreground="#718096"/>
                                        <lvc:CartesianChart
                                            Series="{Binding StudentsPerGroupSeries, Mode=OneWay}"
                                            XAxes="{Binding StudentsPerGroupXAxes, Mode=OneWay}"
                                            YAxes="{Binding StudentsPerGroupYAxes, Mode=OneWay}"
                                            Height="280"
                                            LegendPosition="Hidden"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="8" Padding="18"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Current Rotation Attendance"
                                                       FontSize="15" FontWeight="SemiBold" Foreground="#2D3748"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="#38A169"/>
                                                    <TextBlock Text="80%+" FontSize="11" Foreground="#718096"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="#E53E3E"/>
                                                    <TextBlock Text="Below" FontSize="11" Foreground="#718096"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Expected clock-ins compared with recorded attendance"
                                                   FontSize="12" Foreground="#718096"/>
                                        <lvc:CartesianChart
                                                Series="{Binding AttendanceRateSeries, Mode=OneWay}"
                                                XAxes="{Binding AttendanceRateXAxes, Mode=OneWay}"
                                                YAxes="{Binding AttendanceRateYAxes, Mode=OneWay}"
                                                Height="260"
                                                LegendPosition="Hidden"/>
                                        <TextBlock Text="{Binding NoRotationMessage, Mode=OneWay}"
                                                   FontSize="12" FontStyle="Italic"
                                                   Foreground="#ED8936"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding NoRotationMessage,
                                                                Converter={StaticResource StringToVisible},
                                                                Mode=OneWay}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="8" Padding="18"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="Overall Attendance"
                                                           FontSize="15" FontWeight="SemiBold" Foreground="#2D3748"/>
                                                <ComboBox ItemsSource="{Binding OverallAttendanceRangeOptions}"
                                                          SelectedItem="{Binding SelectedOverallAttendanceRange, Mode=TwoWay}"
                                                          Width="130"
                                                          MinHeight="28"
                                                          Padding="8,2"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="#38A169"/>
                                                    <TextBlock Text="80%+" FontSize="11" Foreground="#718096"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="#E53E3E"/>
                                                    <TextBlock Text="Below" FontSize="11" Foreground="#718096"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding OverallAttendanceScopeDescription, Mode=OneWay}"
                                                       FontSize="12" Foreground="#718096"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="▲" FontSize="11" FontWeight="SemiBold" Foreground="#38A169"/>
                                                    <TextBlock Text="Improving" FontSize="11" Foreground="#718096"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="▼" FontSize="11" FontWeight="SemiBold" Foreground="#E53E3E"/>
                                                    <TextBlock Text="Declining" FontSize="11" Foreground="#718096"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="→" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                                                    <TextBlock Text="Stable" FontSize="11" Foreground="#718096"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <lvc:CartesianChart
                                                Series="{Binding OverallAttendanceRateSeries, Mode=OneWay}"
                                                XAxes="{Binding OverallAttendanceRateXAxes, Mode=OneWay}"
                                                YAxes="{Binding OverallAttendanceRateYAxes, Mode=OneWay}"
                                                Height="260"
                                                LegendPosition="Hidden"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- SECTIONS PANEL -->
                <StackPanel x:Name="SectionsPanel" Visibility="Collapsed" Spacing="20">
                    <TextBlock Text="Sections" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>

                    <!-- Create Section Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create New Section" FontWeight="SemiBold" 
                                       Foreground="#2D3748" FontSize="16"/> 
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ComboBox Header="Section Name" 
                                         ItemsSource="{Binding SectionsList}"
                                          SelectedItem="{Binding SectionName, Mode=TwoWay}"
                                         Width="200" PlaceholderText="e.g. Section A">
                                   
                                </ComboBox>
                                <ComboBox Header="Year Level"
                                         ItemsSource="{Binding YearLevelsList}"
                                         SelectedItem="{Binding YearLevel, Mode=TwoWay}"
                                         Width="120"
                                         PlaceholderText="1-4">
                                </ComboBox>            
                                <Button Content="Create Section" 
                                        VerticalAlignment="Bottom"
                                        Command="{Binding CreateSectionCommand}"
                                        Background="#1B3A6B"
                                        Foreground="White"
                                        CornerRadius="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sections List Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All Sections"  VerticalAlignment="Center" FontWeight="SemiBold" 
                                        Foreground="#2D3748" FontSize="16" Margin="0,0,50,0"/>
                                <TextBlock Text="Sort By:" VerticalAlignment="Center" FontWeight="SemiBold" 
                                           Foreground="#2D3748" FontSize="12" Margin="0,0,15,0"/>
                                <ComboBox FontSize="12" Height="28" VerticalAlignment="Bottom"
                                          ItemsSource="{Binding SortChoicesList}"
                                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                          Width="110" Margin="0,0,8,0">
                                </ComboBox>
                                <Button FontSize="12" Content="Sort" VerticalAlignment="Bottom" Height="28"
                                        Command="{Binding SortSectionsCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="6"/>          

                            </StackPanel>
                            <Grid Padding="8,4" Background="#F7FAFC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Section Name" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Year Level" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Assigned Instructor" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Employee ID" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                            </Grid>
                            <Border Height="1" Background="#E2E8F0"/>


                            <ListView ItemsSource="{Binding Sections}"
                                      SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                      Height="250">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>

                                            </Grid.ColumnDefinitions>

                                            <!-- Section Name -->
                                            <TextBlock Grid.Column="0"
                                               Text="{Binding SectionName}" 
                                               FontWeight="SemiBold" 
                                               Foreground="#2D3748"
                                               VerticalAlignment="Center"/>     

                                            <!-- Year Level -->
                                            <TextBlock Grid.Column="1"
                                               Text="{Binding YearLevel}" 
                                               FontSize="12" 
                                               Foreground="#718096"
                                               VerticalAlignment="Center"/>

                                            <!-- Instructor -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Instructor.FirstName}" 
                                                   FontSize="12" Foreground="#1B3A6B"
                                                   VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Instructor.LastName}" 
                                                   FontSize="12" Foreground="#1B3A6B"
                                                   VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Instructor.EmployeeId}" 
                                                           FontSize="12" Foreground="#1B3A6B"
                                                           VerticalAlignment="Center"/>
                                                
                                            </StackPanel>

                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Assign Instructor Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Manage Section" FontWeight="SemiBold" 
                                       Foreground="#2D3748" FontSize="16"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ComboBox Header="Select Instructor"
                                          ItemsSource="{Binding ActiveInstructors}"
                                          SelectedItem="{Binding SelectedInstructor, Mode=TwoWay}"
                                          Width="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding FirstName}"/>
                                                <TextBlock Text="{Binding LastName}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Assign" VerticalAlignment="Bottom"
                                        Command="{Binding AssignInstructorToSectionCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="8"/>
                                <Button Content="Unassign" VerticalAlignment="Bottom"
                                        Command="{Binding UnassignInstructorCommand}"
                                        Background="#718096" Foreground="White" CornerRadius="8"/>
                                <Button Content="Delete Section" VerticalAlignment="Bottom"
                                        Click="DeleteSection_Clicked"
                                        Background="#E53E3E" Foreground="White" CornerRadius="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- INSTRUCTORS PANEL -->
                <StackPanel x:Name="InstructorsPanel" Visibility="Collapsed" Spacing="20">
                    <TextBlock Text="Clinical Instructors" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>

                    <!-- Create Instructor Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create New Instructor" FontWeight="SemiBold" 
                           Foreground="#2D3748" FontSize="16"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBox Header="First Name" 
                                         Text="{Binding InstructorFirstName, Mode=TwoWay}" 
                                         Width="150" PlaceholderText="First Name"/>
                                    <TextBox Header="Last Name" 
                                         Text="{Binding InstructorLastName, Mode=TwoWay}" 
                                         Width="150" PlaceholderText="Last Name"/>
                                     <TextBox Header="Email" 
                                         Text="{Binding InstructorEmail, Mode=TwoWay}" 
                                         Width="200" PlaceholderText="email@school.com"/>
                                    <TextBox Header="Employee ID" 
                                         Text="{Binding InstructorEmployeeId, Mode=TwoWay}" 
                                         Width="150" PlaceholderText="e.g. EMP001"/>
                                    <Button Content="Create" VerticalAlignment="Bottom"
                                        Command="{Binding CreateInstructorCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="8"/>  
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Instructors List Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">

                            <!-- Header with Sort -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="All Instructors" VerticalAlignment="Center" FontWeight="SemiBold" 
                                        Foreground="#2D3748" FontSize="16"/>
                                <ToggleSwitch IsOn="{Binding ShowInactiveInstructors, Mode=TwoWay}"
                                              OffContent="Active Only" 
                                              OnContent="Show Inactive"
                                              FontSize="12"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"/>  
                                <TextBlock Text="Sort by:" VerticalAlignment="Center" 
                                        Foreground="#718096" FontSize="12" Margin="0,0,0,0"/>
                                <Button Content="Last Name" 
                                        VerticalAlignment="Center"
                                        Command="{Binding SortInstructorsByLastNameCommand}"
                                        Background="#E2E8F0" Foreground="#2D3748"
                                        CornerRadius="6" Padding="8,4"/>
                                <TextBlock Text="Search:" VerticalAlignment="Center" 
                                        Foreground="#718096" FontSize="12" Margin="16,0,0,0"/>
                                <TextBox Text="{Binding InstructorSearchQuery, Mode=TwoWay}"
                                         VerticalAlignment="Center"
                                            PlaceholderText="All Instructors"
                                            Width="200"/>
                                <Button Content="Search" 
                                        Command="{Binding SearchInstructorCommand}"
                                        Background="#E2E8F0" Foreground="#2D3748"
                                        CornerRadius="6" Padding="8,4"/>
                                

                            </StackPanel>

                            <!-- List -->
                            <Grid Padding="20,4" Margin="0,16,0,0" Background="#F7FAFC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Last Name" FontWeight="SemiBold" 
                                           Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="First Name" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Employee ID" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Email" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" 
                                            Foreground="#718096" FontSize="12"/>
                            </Grid>

                            <!-- Divider -->
                            <ListView ItemsSource="{Binding DisplayInstructors}"
                                      SelectedItem="{Binding SelectedInstructor, Mode=TwoWay}"
                                      Height="300">
                                
                                
                                
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Last Name -->
                                            <TextBlock Grid.Column="0"
                                       Text="{Binding LastName}" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2D3748"
                                       VerticalAlignment="Center"/>

                                            <!-- First Name -->
                                            <TextBlock Grid.Column="1"
                                       Text="{Binding FirstName}" 
                                       Foreground="#2D3748"
                                       VerticalAlignment="Center"/>

                                            <!-- Employee ID -->
                                            <TextBlock Grid.Column="2"
                                       Text="{Binding EmployeeId}" 
                                       Foreground="#718096"
                                       VerticalAlignment="Center"/>

                                            <!-- Email -->
                                            <TextBlock Grid.Column="3"
                                       Text="{Binding Email}" 
                                       FontSize="12"
                                       Foreground="#718096"
                                       VerticalAlignment="Center"/>

                                            <!-- Active Status -->
                                            <TextBlock Grid.Column="4" 
                                                       Text="{Binding StatusText}"
                                                       Foreground="#718096"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/> 

                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Deactivate" 
                                        Click="DeactivateInstructor_Clicked"
                                        Background="#E53E3E" Foreground="White" CornerRadius="8"/>
                                <Button Content="Reactivate" 
                                        Command="{Binding ReactivateUserCommand}"
                                        Background="#38A169" Foreground="White" CornerRadius="8"/>
                                <Button Content="Edit Instructor"
                                        Click="EditInstructor_Clicked"
                                        Background="#1B3A6B" Foreground="White"
                                        CornerRadius="8" Padding="16,8"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                   

                </StackPanel>
                <!-- HOSPITALS PANEL -->
                <StackPanel x:Name="HospitalsPanel" Visibility="Collapsed" Spacing="20">
                    <TextBlock Text="Hospitals" FontSize="28" FontWeight="Bold" Foreground="#1B3A6B"/>

                    <!-- Create Hospital Card -->
                    <Border Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create New Hospital" FontWeight="SemiBold" 
                       Foreground="#2D3748" FontSize="16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Hospital Name" 
                                         Text="{Binding HospitalName, Mode=TwoWay}" 
                                         PlaceholderText="Hospital Name" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Header="Address" 
                                         Text="{Binding HospitalAddress, Mode=TwoWay}" 
                                         PlaceholderText="Address" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Create Hospital" 
                                        VerticalAlignment="Bottom"
                                        Command="{Binding CreateHospitalCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="8"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Hospital List + Station List Side by Side -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Hospitals List -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="12">

                                <!-- Header + Sort + Search -->
                                <TextBlock Text="All Hospitals" FontWeight="SemiBold" 
                                           Foreground="#2D3748" FontSize="16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding HospitalSearchName, Mode=TwoWay}"
                                             PlaceholderText="Search hospital..."
                                             Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Search" 
                                                Command="{Binding GetHospitalsByNameCommand}"
                                                Background="#E2E8F0" Foreground="#2D3748"
                                                CornerRadius="6" Padding="8,4"/>
                                        <Button Content="Sort A-Z" 
                                                Command="{Binding SortHospitalsByNameCommand}"
                                                Background="#E2E8F0" Foreground="#2D3748"
                                                CornerRadius="6" Padding="8,4"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Column Headers -->
                                <Grid Padding="8,4" Background="#F7FAFC">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="245"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hospital" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Address" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>
                                </Grid>
                                <Border Height="1" Background="#E2E8F0"/>

                                <!-- List -->
                                <ListView ItemsSource="{Binding Hospitals}"
                                          SelectedItem="{Binding SelectedHospital, Mode=TwoWay}"
                                          Height="300">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding HospitalName}" 
                                                           FontWeight="SemiBold" Foreground="#2D3748"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Address}" 
                                                           FontSize="12" Foreground="#718096"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button Content="Delete Hospital" 
                                         Click="DeleteHospital_Clicked"
                                        Background="#E53E3E" Foreground="White" CornerRadius="8"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT: Stations List -->
                        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="12">

                                <TextBlock Text="Stations" FontWeight="SemiBold" 
                                            Foreground="#2D3748" FontSize="16"/>

                                <!-- Add Station Form -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                         Text="{Binding StationName, Mode=TwoWay}" 
                                         PlaceholderText="Station Name" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" 
                                        Text="{Binding StationCapacity, Mode=TwoWay}" 
                                        PlaceholderText="Capacity" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Add" 
                                        VerticalAlignment="Bottom"
                                        Command="{Binding AddStationCommand}"
                                        Background="#1B3A6B" Foreground="White" CornerRadius="8"/>
                                </Grid>

                                <!-- Column Headers -->
                                <Grid Padding="8,4" Background="#F7FAFC">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="275"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Station" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Capacity" FontWeight="SemiBold" 
                                                Foreground="#718096" FontSize="12"/>
                                </Grid>
                                <Border Height="1" Background="#E2E8F0"/>

                                <!-- Stations List -->
                                <ListView ItemsSource="{Binding SelectedHospitalStations}"
                                          SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                          Height="300">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StationName}" 
                                                           FontWeight="SemiBold" Foreground="#2D3748"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Capacity}" 
                                                           FontSize="12" Foreground="#718096"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button Content="Remove Station" 
                                        Click="RemoveStation_Clicked"
                                        Background="#E53E3E" Foreground="White" CornerRadius="8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                  
                </StackPanel>
                
                <!-- Error Message -->
                <TextBlock HorizontalAlignment ="Center" Text="{Binding ErrorMessage}" Foreground="#E53E3E" 
                           VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                <!-- Success Message -->
                <TextBlock HorizontalAlignment ="Center" Text="{Binding SuccessMessage}" Foreground="#38A169" 
                           VerticalAlignment="Bottom" Margin="0,0,0,16"/>

                

            </Grid>
        </NavigationView>
    </Grid>
</Page>
